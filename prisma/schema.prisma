generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())

  posts Post[]

  @@map("users")
}

model Post {
  id           Int           @id @default(autoincrement())
  title        String
  description  String
  category     PostCategory
  type    PostType @default(NEED)
  rewardAmount Float?
  location     String?
  createdAt    DateTime      @default(now())

  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  @@map("posts")
}
enum PostCategory {
  PRODUCT
  JOB
  HELP
  HOUSING
  TRANSPORT
  VOLUNTEERING
}
enum PostType {
  OFFER
  NEED
}

